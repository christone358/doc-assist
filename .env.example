# NextAgent Doc Assistant - 环境变量配置示例
# 复制此文件为 .env 并填写实际值

# ============================================================
# 通用配置
# ============================================================

# 前端 URL（用于 CORS 配置，生产环境需修改）
FRONTEND_URL=http://localhost:5173

# 允许的 CORS 来源（多个用逗号分隔，* 表示允许所有）
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ============================================================
# 目录配置（Docker 部署时可通过卷挂载覆盖）
# ============================================================

# 文档输出目录（默认: ./docs）
# DOCS_ROOT=/data/docs

# 项目事实信息目录（默认: ./project-facts）
# PROJECT_FACTS_ROOT=/data/project-facts

# Skill 目录（默认: ./skills）
# SKILLS_ROOT=/data/skills

# ============================================================
# LLM 配置（可选，也可通过 Web UI 配置）
# ============================================================

# DeepSeek API Key（从 https://platform.deepseek.com 获取）
# DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx

# 通义千问 (QWen) API Key（从 https://dashscope.aliyuncs.com 获取）
# DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx

# ============================================================
# 日志配置
# ============================================================

# 日志级别: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
